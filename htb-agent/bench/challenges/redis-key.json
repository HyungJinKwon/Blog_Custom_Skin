{
  "name": "redis-key",
  "title": "인증 없는 Redis 의 키 값",
  "difficulty": "medium",
  "lesson": "키 목록을 본 뒤 해당 키의 값을 조회",
  "ports": [[6379, "redis"]],
  "responses": [
    {"match": "get flag", "stdout": "\"FLAG{unauthenticated_cache}\""},
    {"match": "--scan", "stdout": "session:42\nflag\nconfig"},
    {"match": "ping", "stdout": "PONG"}
  ],
  "flag": "FLAG{unauthenticated_cache}"
}
